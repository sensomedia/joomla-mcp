<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>plg_system_sensomcpchangelog</name>
    <author>Fred Oliver</author>
    <authorEmail>fred@sensomedia.com</authorEmail>
    <authorUrl>https://sensomedia.com</authorUrl>
    <copyright>(C) 2026 Sensomedia. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>1.4.0</version>
    <creationDate>2026-09-10</creationDate>
    <description>PLG_SYSTEM_SENSOMCPCHANGELOG_XML_DESCRIPTION</description>

    <scriptfile>script.php</scriptfile>

    <namespace path="src">Sensomedia\Plugin\System\SensomcpChangelog</namespace>

    <files>
        <folder plugin="sensomcpchangelog">services</folder>
        <folder>src</folder>
        <filename>CHANGELOG.md</filename>
    </files>

    <languages>
        <language tag="fr-FR">language/fr-FR/plg_system_sensomcpchangelog.ini</language>
        <language tag="fr-FR">language/fr-FR/plg_system_sensomcpchangelog.sys.ini</language>
        <language tag="en-GB">language/en-GB/plg_system_sensomcpchangelog.ini</language>
        <language tag="en-GB">language/en-GB/plg_system_sensomcpchangelog.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="caching"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="PLG_SYSTEM_SENSOMCPCHANGELOG_CACHING_LABEL"
                    description="PLG_SYSTEM_SENSOMCPCHANGELOG_CACHING_DESC"
                    default="1">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="cache_time"
                    type="number"
                    label="PLG_SYSTEM_SENSOMCPCHANGELOG_CACHE_TIME_LABEL"
                    description="PLG_SYSTEM_SENSOMCPCHANGELOG_CACHE_TIME_DESC"
                    default="360"
                    min="1"
                    showon="caching:1" />
            </fieldset>
        </fields>
    </config>
</extension>
